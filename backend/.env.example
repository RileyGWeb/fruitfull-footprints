APP_NAME="Fruitfull Footprints"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8110

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Postgres from the repo's docker-compose.yml (tests use the fruitfull_test database, see phpunit.xml).
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5490
DB_DATABASE=fruitfull
DB_USERNAME=fruitfull
DB_PASSWORD=fruitfull

# A year: unlocking is "remember this device".
SESSION_DRIVER=database
SESSION_LIFETIME=525600
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# The shared group password. `php artisan db:seed` hashes it into the settings table when no
# password is set yet; it is never read again after that. Change it later with
# `php artisan ff:password` or from Settings in the app. Locally we use `footprints`.
GROUP_PASSWORD=

# Proxies to trust besides 127.0.0.1 and ::1 (comma-separated). Laravel takes the client IP
# (which the unlock throttle keys on) from the rightmost untrusted X-Forwarded-For entry. Next
# passes the browser's X-Forwarded-For through untouched, so production needs a reverse proxy in
# front of Next that appends the real socket address; list here the Next host if it isn't this
# machine, and any CDN or load balancer in front of that reverse proxy.
TRUSTED_PROXIES=

# ── Production ───────────────────────────────────────────────────────────────────────────────
# Start from the values above and change these (checklist in backend/README.md):
# APP_ENV=production
# APP_DEBUG=false                  # never true here: errors would show traces, paths and SQL
# APP_URL=https://footprints.example.org
# LOG_LEVEL=warning
# SESSION_SECURE_COOKIE=true       # already the default when APP_ENV=production
# DB_PASSWORD=<a real password>
# GROUP_PASSWORD=                  # or set it with `php artisan ff:password`
